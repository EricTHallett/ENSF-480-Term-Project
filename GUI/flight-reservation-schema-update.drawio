        <mxCell id="reservationManifest" edge="1" parent="1" source="reservation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;startArrow=none;endArrow=open;strokeColor=#666666;fontSize=10;" target="manifest" value="derives">
